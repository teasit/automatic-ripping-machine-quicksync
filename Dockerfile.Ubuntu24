ARG REPO
FROM ghcr.io/$REPO-ubuntu24-base:latest

# Reinstall the upstream ARM HandBrake build dependencies after the distro upgrade, then
# rebuild HandBrakeCLI so it links against Ubuntu 24's newer VA-API stack.
RUN chmod +x /install_mkv_hb_deps.sh /install_handbrake.sh && \
    /install_mkv_hb_deps.sh && \
    /install_handbrake.sh

# Show the runtime libva version that HandBrakeCLI will resolve against.
RUN pkg-config --modversion libva && ldconfig
